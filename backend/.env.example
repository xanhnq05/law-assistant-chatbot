# ============================================================
# Sao chép file này thành ".env" rồi điền giá trị thật.
# Đặt ".env" trong thư mục `backend/`.
# KHÔNG commit ".env" lên git.
# ============================================================

# -------------------- MONGO --------------------
# Ví dụ Atlas:
#   mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
DATABASE_NAME=law_assistant

# -------------------- GOOGLE OAUTH --------------------
# Tạo project tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải trỏ đến: <BACKEND>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -------------------- JWT --------------------
# Đổi thành secret ngẫu nhiên dài >= 32 ký tự trong production.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -------------------- LLM (Groq) --------------------
GROQ_API_KEY=

# -------------------- VECTOR DB (Pinecone) --------------------
PINECONE_API_KEY=

# -------------------- GRAPH DB (Neo4j) --------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# -------------------- FRONTEND --------------------
# URL nơi user sẽ được redirect về sau khi đăng nhập Google.
# Phải khớp với nơi frontend được phục vụ.
FRONTEND_URL=http://localhost:5500