{
  "_comment": "JSON Schema chuẩn hóa cấu trúc dữ liệu văn bản pháp luật VN. Version: 1.0.0 - 2026-08-16. Áp dụng cho cả Luật, Nghị định, Pháp lệnh, Thông tư, Quyết định. Hỗ trợ cả 2 schema input: A (chapters ở root, dùng 'label' cho point) và B (chapters trong document.structure.chapters, có thể dùng 'number' thay 'label').",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trolyluat.vn/schema/v1/legal-document.schema.json",
  "title": "Legal Document",
  "type": "object",
  "required": ["document"],
  "properties": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "document_type",
        "issuing_authority",
        "date_enacted",
        "date_effective"
      ],
      "_comment_required": "document_number is optional: some files use 'number' instead (kept for backward compatibility).",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]+-[0-9]+-[A-Z0-9]+(-[A-Z0-9]+)?$",
          "examples": ["L36-2024-QH15", "D168-2024-ND-CP"]
        },
        "title": { "type": "string", "minLength": 5 },
        "document_type": {
          "type": "string",
          "enum": ["Luật", "Nghị định", "Pháp lệnh", "Thông tư", "Quyết định", "Chỉ thị"]
        },
        "document_number": {
          "type": "string",
          "examples": ["36/2024/QH15", "168/2024/NĐ-CP"]
        },
        "issuing_authority": {
          "type": "string",
          "examples": ["Quốc hội", "Chính phủ", "Bộ Giao thông vận tải"]
        },
        "date_enacted": { "type": "string", "format": "date" },
        "date_effective": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["active", "expired", "amended", "draft"],
          "default": "active"
        },
        "source_file": { "type": "string" },
        "source_version": { "type": "string" },
        "effective_date_notes": { "type": "string" },
        "part": { "type": "string" },
        "part_note": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "number": { "type": "string" },
        "structure": { "$ref": "#/definitions/Structure" }
      }
    },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/definitions/Chapter" }
    },
    "schema_version": { "type": "string" }
  },
  "definitions": {
    "Structure": {
      "type": "object",
      "properties": {
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Chapter" }
        }
      }
    },
    "Chapter": {
      "type": "object",
      "required": ["id", "articles"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+-\\d{4}-[A-Z0-9-]+$",
          "description": "ID chương (hỗ trợ nhiều format: L36-2024-QH15-CII, D168-2024-ND-CP-CH-IV)"
        },
        "number": { "type": "string" },
        "title": { "type": "string" },
        "document_id": { "type": "string" },
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] },
        "sections": {
          "type": "array",
          "items": { "type": "object" }
        },
        "articles": {
          "type": "array",
          "items": { "$ref": "#/definitions/Article" }
        }
      }
    },
    "Article": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+-\\d{4}-[A-Z0-9-]+-A-?\\d+$",
          "description": "ID điều (hỗ trợ nhiều format: CII-A24, CII-B-A24, CH-IV-A-52)"
        },
        "number": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "content": { "type": "string" },
        "chapter_id": { "type": "string" },
        "document_id": { "type": "string" },
        "section": { "type": ["string", "null"] },
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] },
        "clauses": {
          "type": "array",
          "items": { "$ref": "#/definitions/Clause" }
        }
      }
    },
    "Clause": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+-\\d{4}-[A-Z0-9-]+-A-?\\d+-K-?\\d+$"
        },
        "number": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "article_id": { "type": "string" },
        "document_id": { "type": "string" },
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] },
        "points": {
          "type": "array",
          "items": { "$ref": "#/definitions/Point" }
        }
      }
    },
    "Point": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+-\\d{4}-[A-Z0-9-]+-A-?\\d+-K-?\\d+-P[a-zđ]+$"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-zđ]+$",
          "description": "Nhãn điểm: a, b, c, d, đ, e, g, h, i, k..."
        },
        "number": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "clause_id": { "type": "string" },
        "document_id": { "type": "string" },
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] }
      }
    }
  }
}