# Copy thành ".env" và điền giá trị thật. KHÔNG commit ".env" lên git.

# --- Mongo (bạn đã có sẵn) ---
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
DATABASE_NAME=

# --- Google OAuth (lấy tại console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- JWT nội bộ ---
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Frontend (nơi user được redirect về sau khi đăng nhập Google) ---
FRONTEND_URL=http://localhost:5500
